# Copy this file to .env and fill in real values. Never commit .env.

# --- Application ---
BASE_URL=https://audit-uat.audtech.co.in
LOGIN_PATH=/#/login
DASHBOARD_PATH=/#/dashboard

# --- Valid credentials ---
VALID_USERNAME=
VALID_PASSWORD=

# --- Negative-test credentials (optional, used by login negative tests) ---
INVALID_USERNAME=
INVALID_PASSWORD=
OLD_PASSWORD=

# --- Known UAT fixtures (optional; defaults match common demo data) ---
KNOWN_CLIENT_NAME=Apex Finserve Private Limited
KNOWN_ASSIGNMENT_NAME=Test AWMS_295 3.08.2026

# --- Playwright execution ---
HEADLESS=true
SLOW_MO_MS=0
DEFAULT_TIMEOUT_MS=15000
NAV_TIMEOUT_MS=30000
VIEWPORT_WIDTH=1440
VIEWPORT_HEIGHT=900

# --- Retry / self-healing ---
MAX_ACTION_RETRIES=2
RETRY_BACKOFF_MS=1000
